{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retro-2 curated incident",
  "type": "object",
  "required": ["incident_id", "title", "source", "risk_class", "root_cause_family", "fixture", "expected_observable", "mechanical_checks", "judge_question", "positive_control", "negative_control", "severity", "admission"],
  "properties": {
    "incident_id": {"type": "string", "pattern": "^INC-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["kind", "path", "lines", "evidence_sha256"]},
    "risk_class": {"enum": ["confidentiality", "correctness", "rollback", "wiring", "cost"]},
    "fixture": {"type": "object", "minProperties": 1},
    "mechanical_checks": {"type": "array", "minItems": 1},
    "judge_question": {"type": "array", "minItems": 1, "maxItems": 1},
    "positive_control": {"type": "array", "minItems": 1, "maxItems": 1},
    "severity": {"enum": ["blocker", "major"]}
  }
}

